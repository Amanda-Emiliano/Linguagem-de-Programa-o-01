algoritmo "Media"

var
   P1, E1, E2, X, SUB, API, EXF: real
   media1, diferenca: real
   parteMedia, parteAPI, mediaFinal: real

inicio

   escreva("Digite a nota da Prova 1: ")
   leia(P1)

   escreva("Digite a nota da Entrega 1: ")
   leia(E1)

   escreva("Digite a nota da Entrega 2: ")
   leia(E2)

   escreva("Digite a nota da Atividade Extra: ")
   leia(X)

   escreva("Digite a nota da Substitutiva: ")
   leia(SUB)

   escreva("Digite a nota da API: ")
   leia(API)


   media1 <- P1 * 0.5 + E1 * 0.2 + E2 * 0.3 + X + SUB * 0.15

   diferenca <- media1 - 5.9

   parteMedia <- media1 * 0.5

   se diferenca > 0 entao
      parteAPI <- (diferenca / diferenca) * API * 0.5
   senao
      parteAPI <- 0
   fimse

   mediaFinal <- parteMedia + parteAPI


   escreval("")
   escreval("Média final: ", mediaFinal:4:2)


   se mediaFinal >= 6 entao

      escreval("Aluno aprovado!")

   senao

      se mediaFinal >= 4 entao

         escreval("Aluno em recuperação.")
         escreval("Deve realizar o exame final.")

         escreva("Digite a nota do Exame Final: ")
         leia(EXF)

         se EXF > mediaFinal entao
            mediaFinal <- EXF
         fimse

         escreval("Média após o exame: ", mediaFinal:4:2)

         se mediaFinal >= 6 entao
            escreval("Aluno aprovado!")
         senao
            escreval("Aluno reprovado.")
         fimse

      senao

         escreval("Aluno reprovado.")
         escreval("Não pode realizar o exame final.")

      fimse

   fimse

fimalgoritmo
