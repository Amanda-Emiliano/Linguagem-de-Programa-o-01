import java.util.Scanner;

public class Desconto {
    public void desconto() {

        Scanner s = new Scanner(System.in);

        int qtdArroz, qtdFeijao, qtdOleo, qtdAcucar, qtdCafe;
        int qtdMacarrao, qtdFarinha, qtdFuba, qtdMolho, qtdSal;

        double precoArroz, precoFeijao, precoOleo, precoAcucar, precoCafe;
        double precoMacarrao, precoFarinha, precoFuba, precoMolho, precoSal;

        double total, desconto, valorFinal;


        IO.println("Quantidade de Arroz (5 kg):");
        qtdArroz = s.nextInt();
        IO.println("Preço do Arroz:");
        precoArroz = s.nextDouble();

        IO.println("Quantidade de Feijão (1 kg a 2 kg):");
        qtdFeijao = s.nextInt();
        IO.println("Preço do Feijão:");
        precoFeijao = s.nextDouble();

        IO.println("Quantidade de Óleo (900 ml):");
        qtdOleo = s.nextInt();
        IO.println("Preço do Óleo:");
        precoOleo = s.nextDouble();

        IO.println("Quantidade de Açúcar (1 kg):");
        qtdAcucar = s.nextInt();
        IO.println("Preço do Açúcar:");
        precoAcucar = s.nextDouble();

        IO.println("Quantidade de Café (250 g ou 500 g):");
        qtdCafe = s.nextInt();
        IO.println("Preço do Café:");
        precoCafe = s.nextDouble();

        IO.println("Quantidade de Macarrão (500 g):");
        qtdMacarrao = s.nextInt();
        IO.println("Preço do Macarrão:");
        precoMacarrao = s.nextDouble();

        IO.println("Quantidade de Farinha (1 kg ou 500 g):");
        qtdFarinha = s.nextInt();
        IO.println("Preço da Farinha:");
        precoFarinha = s.nextDouble();

        IO.println("Quantidade de Fubá (500 g):");
        qtdFuba = s.nextInt();
        IO.println("Preço do Fubá:");
        precoFuba = s.nextDouble();

        IO.println("Quantidade de Molho (300 g):");
        qtdMolho = s.nextInt();
        IO.println("Preço do Molho:");
        precoMolho = s.nextDouble();

        IO.println("Quantidade de Sal (1 kg):");
        qtdSal = s.nextInt();
        IO.println("Preço do Sal:");
        precoSal = s.nextDouble();


        total = qtdArroz * precoArroz
                + qtdFeijao * precoFeijao
                + qtdOleo * precoOleo
                + qtdAcucar * precoAcucar
                + qtdCafe * precoCafe
                + qtdMacarrao * precoMacarrao
                + qtdFarinha * precoFarinha
                + qtdFuba * precoFuba
                + qtdMolho * precoMolho
                + qtdSal * precoSal;


        if (total > 100) {
            desconto = total * 0.10;
            valorFinal = total - desconto;
        } else {
            desconto = 0;
            valorFinal = total;
        }


        IO.println("");
        IO.println("===== PRODUTOS =====");

        IO.println("Arroz (5 kg) - " + qtdArroz
                + " unidade(s) - R$ " + qtdArroz * precoArroz);

        IO.println("Feijão (1 kg a 2 kg) - " + qtdFeijao
                + " unidade(s) - R$ " + qtdFeijao * precoFeijao);

        IO.println("Óleo (900 ml) - " + qtdOleo
                + " unidade(s) - R$ " + qtdOleo * precoOleo);

        IO.println("Açúcar (1 kg) - " + qtdAcucar
                + " unidade(s) - R$ " + qtdAcucar * precoAcucar);

        IO.println("Café (250 g ou 500 g) - " + qtdCafe
                + " unidade(s) - R$ " + qtdCafe * precoCafe);

        IO.println("Macarrão (500 g) - " + qtdMacarrao
                + " unidade(s) - R$ " + qtdMacarrao * precoMacarrao);

        IO.println("Farinha (1 kg ou 500 g) - " + qtdFarinha
                + " unidade(s) - R$ " + qtdFarinha * precoFarinha);

        IO.println("Fubá (500 g) - " + qtdFuba
                + " unidade(s) - R$ " + qtdFuba * precoFuba);

        IO.println("Molho (300 g) - " + qtdMolho
                + " unidade(s) - R$ " + qtdMolho * precoMolho);

        IO.println("Sal (1 kg) - " + qtdSal
                + " unidade(s) - R$ " + qtdSal * precoSal);


        IO.println("");
        IO.println("Valor da compra: R$ " + total);
        IO.println("Desconto: R$ " + desconto);
        IO.println("Valor final a pagar: R$ " + valorFinal);
    }
}
