public class Cabelos {

    private String cor;
    private String tamanho;
    private String estilo;

    public Cabelos(String cor, String tamanho, String estilo) {
        this.cor = cor;
        this.tamanho = tamanho;
        this.estilo = estilo;
    }

    public void setCor(String cor) {
        this.cor = cor;
    }

    public String getCor() {
        return cor;
    }

    public void setTamanho(String tamanho) {
        this.tamanho = tamanho;
    }

    public String getTamanho() {
        return tamanho;
    }

    public void setEstilo(String estilo) {
        this.estilo = estilo;
    }

    public String getEstilo() {
        return estilo;
    }

    public void cortarCabelo() {
        System.out.println("O cabelo foi cortado.");
    }

    public void pentearCabelo() {
        System.out.println("O cabelo foi penteado.");
    }

    public void pintarCabelo() {
        System.out.println("O cabelo foi pintado.");
    }
}
