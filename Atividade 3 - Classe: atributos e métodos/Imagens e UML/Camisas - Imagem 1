public class Camisas {

    private String cor;
    private String tamanho;
    private String marca;

    public Camisas(String cor, String tamanho, String marca) {
        this.cor = cor;
        this.tamanho = tamanho;
        this.marca = marca;
    }

    public void setCor(String cor) {
        this.cor = cor;
    }

    public String getCor() {
        return cor;
    }

    public void setTamanho(String tamanho) {
        this.tamanho = tamanho;
    }

    public String getTamanho() {
        return tamanho;
    }

    public void setMarca(String marca) {
        this.marca = marca;
    }

    public String getMarca() {
        return marca;
    }

    public void vestir() {
        System.out.println("A camisa foi vestida.");
    }

    public void lavarCamisa() {
        System.out.println("A camisa foi lavada.");
    }

    public void dobrar() {
        System.out.println("A camisa foi dobrada.");
    }
}
