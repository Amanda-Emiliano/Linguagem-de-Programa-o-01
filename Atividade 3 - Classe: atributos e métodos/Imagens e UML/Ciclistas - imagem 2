public class Ciclista {

    private String nome;
    private int idade;
    private boolean pedalaAcompanhado;

    //construtor
    public Ciclista(String nome, int idade, boolean pedalaAcompanhado) {
        this.nome = nome;
        this.idade = idade;
        this.pedalaAcompanhado = pedalaAcompanhado;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public String getNome() {
        return nome;
    }

    public void setIdade(int idade) {
        this.idade = idade;
    }

    public int getIdade() {
        return idade;
    }

    public void setPedalaAcompanhado(boolean pedalaAcompanhado) {
        this.pedalaAcompanhado = pedalaAcompanhado;
    }

    public boolean getPedalaAcompanhado() {
        return pedalaAcompanhado;
    }


    public void pedalar() {
        System.out.println("O ciclista está pedalando.");
    }

    public void frear() {
        System.out.println("O ciclista está freando.");
    }

    public void parar() {
        System.out.println("O ciclista parou.");
    }
}
